@model Lead
@using Microsoft.AspNetCore.Mvc.Rendering

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LeadName" class="form-label"></label>
        <input asp-for="LeadName" class="form-control" />
        <span asp-validation-for="LeadName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" type="tel" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" asp-items="new SelectList(LeadSources.All)" class="form-select"></select>
        <span asp-validation-for="Source" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="new SelectList(LeadStatus.All)" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ExpectedValue" class="form-label"></label>
        <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
    </div>
    <partial name="_AssignField" model="Model.AssignedUserId" />
</div>
