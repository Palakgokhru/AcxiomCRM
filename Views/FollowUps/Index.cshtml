@model IEnumerable<FollowUp>
@{
    ViewData["Title"] = "Follow-ups";
    var view = ViewData["View"] as string;
    var views = new[] { ("Pending", "Pending"), ("Overdue", "Overdue"), ("Upcoming", "Next 7 days"),
                        ("Completed", "Completed"), ("Missed", "Missed"), ("Cancelled", "Cancelled"), ("All", "All") };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Follow-ups</h1>
    <a asp-action="Create" class="btn btn-primary">+ Schedule Follow-up</a>
</div>
<partial name="_Alerts" />

<ul class="nav nav-pills mb-3 flex-wrap">
    @foreach (var (key, label) in views)
    {
        <li class="nav-item">
            <a class="nav-link @(key == view ? "active" : "")" asp-action="Index" asp-route-view="@key">@label</a>
        </li>
    }
</ul>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="view" value="@view" />
    <div class="col-md-3"><input name="related" value="@ViewData["Related"]" class="form-control" placeholder="Customer, lead or opportunity" /></div>
    <div class="col-md-2"><input type="date" name="from" value="@ViewData["From"]" class="form-control" aria-label="From date" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@ViewData["To"]" class="form-control" aria-label="To date" /></div>
    <partial name="_AssignedFilter" />
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" asp-route-view="@view" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any()) { <div class="alert alert-light border">No follow-ups match.</div> }
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Related To</th><th>Remarks</th><th>Status</th><th>Assigned To</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    var overdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                    <tr class="@(overdue ? "table-danger" : f.Status == "Planned" && f.FollowUpDate.Date == DateTime.Today ? "table-warning" : "")">
                        <td class="text-nowrap"><a asp-action="Details" asp-route-id="@f.Id">@f.FollowUpDate.ToString("dd MMM yyyy")</a> @if (overdue) { <span class="badge bg-danger">Overdue</span> }</td>
                        <td>@f.FollowUpType</td>
                        <td class="small">
                            @if (f.Customer is not null) { <div>Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId">@f.Customer.CustomerName</a></div> }
                            @if (f.Lead is not null) { <div>Lead: <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId">@f.Lead.LeadName</a></div> }
                            @if (f.Opportunity is not null) { <div>Opportunity: <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId">@f.Opportunity.OpportunityName</a></div> }
                        </td>
                        <td class="small">@f.Remarks</td>
                        <td>@f.Status</td>
                        <td>@(f.AssignedUser?.UserName ?? "—")</td>
                        <td class="text-nowrap text-end">
                            @if (f.Status == "Planned")
                            {
                                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">Reschedule</a>
                                <partial name="_StatusButtons" model="f" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
