@model IEnumerable<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
    var stage = ViewData["Stage"] as string;
    var status = ViewData["Status"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Opportunities</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Opportunity</a>
</div>
<partial name="_Alerts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name or customer" /></div>
    <partial name="_AssignedFilter" />
    <div class="col-md-2">
        <select name="stage" class="form-select">
            <option value="">All stages</option>
            @foreach (var s in OpportunityStage.All) { <option value="@s" selected="@(s == stage)">@s</option> }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in OpportunityStatus.All) { <option value="@s" selected="@(s == status)">@s</option> }
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any()) { <div class="alert alert-light border">No opportunities found.</div> }
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light"><tr><th>Name</th><th>Customer</th><th class="text-end">Amount</th><th>Stage</th><th>Prob.</th><th>Close Date</th><th>Status</th><th>Assigned To</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@o.Id">@o.OpportunityName</a></td>
                        <td>@o.Customer?.CustomerName</td>
                        <td class="text-end">@o.Amount.ToString("N2")</td>
                        <td>@o.Stage</td>
                        <td>@o.Probability%</td>
                        <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(o.Status == "Open" ? "bg-success" : "bg-secondary")">@o.Status</span></td>
                        <td>@(o.AssignedUser?.UserName ?? "—")</td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
