@model Opportunity
@{
    ViewData["Title"] = Model.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.OpportunityName</h1>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Id" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary">Schedule follow-up</a>
        <a asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@Model.Id" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary">Log activity</a>
        @if (Model.Status == "Open")
        {
            <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Close this opportunity as Lost?');">
                <button class="btn btn-outline-warning">Close as Lost</button>
            </form>
        }
        @if (User.IsInRole("Admin"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Permanently delete this opportunity? This cannot be undone.');">
                <button class="btn btn-outline-danger">Delete</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
<partial name="_Alerts" />

<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Opportunity Id</dt><dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.CustomerName</a></dd>
        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">
            @if (Model.Lead is not null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a> } else { <span>—</span> }
        </dd>
        <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>
        <dt class="col-sm-3">Stage</dt><dd class="col-sm-9">@Model.Stage</dd>
        <dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability%</dd>
        <dt class="col-sm-3">Expected Close</dt><dd class="col-sm-9">@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9">@(Model.AssignedUser?.UserName ?? "Unassigned")</dd>
        <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm") by @Model.CreatedBy</dd>
    </dl>
</div></div>

<partial name="_RelatedLists" />
