@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<h1 class="h3 mb-3">Edit Customer <span class="text-muted fs-5">@Model.CustomerCode</span></h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <partial name="_Form" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
