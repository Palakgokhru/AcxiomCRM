@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<h1 class="h3 mb-3">Delete or deactivate @Model.CustomerName <span class="text-muted fs-5">@Model.CustomerCode</span></h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<partial name="_Summary" model="Model" />

<div class="alert alert-warning mt-3">
    <strong>Deactivate</strong> keeps the record and its history but marks it Inactive.
    @if (User.IsInRole("Admin"))
    {
        <span><strong>Delete permanently</strong> removes it from the database and cannot be undone.</span>
    }
</div>

<div class="d-flex gap-2">
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-warning" disabled="@(Model.Status == "Inactive")">Deactivate</button>
    </form>
    @if (User.IsInRole("Admin"))
    {
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Permanently delete this customer?');">
            <button type="submit" class="btn btn-danger">Delete permanently</button>
        </form>
    }
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</div>
