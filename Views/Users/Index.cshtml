@model IEnumerable<AcxiomCRM.Controllers.UserRow>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-primary">+ New User</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
    <table class="table align-middle bg-white">
        <thead class="table-light"><tr><th>Email</th><th>Role</th><th>Status</th><th>Change role</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Email</td>
                    <td>@(string.IsNullOrEmpty(u.Role) ? "(none)" : u.Role)</td>
                    <td>@(u.IsLockedOut ? "Locked" : "Active")</td>
                    <td>
                        <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="d-flex gap-1">
                            <select name="role" class="form-select form-select-sm" style="max-width:160px">
                                @foreach (var r in AcxiomCRM.Data.Roles.All)
                                {
                                    <option value="@r" selected="@(u.Role == r)">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post">
                            <button type="submit" class="btn btn-sm @(u.IsLockedOut ? "btn-outline-success" : "btn-outline-warning")">@(u.IsLockedOut ? "Unlock" : "Lock")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
