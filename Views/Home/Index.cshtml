@{
    ViewData["Title"] = "Dashboard";
    var pending = (List<FollowUp>)ViewBag.PendingFollowUps;
}

<div class="mb-4">
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">
        Welcome, @User.Identity?.Name.
        @(User.IsInRole("SalesExecutive") ? "Figures show records assigned to you." : "Figures show all team records.")
    </p>
</div>

@{
    var cards = new (string Label, string Value, string Controller, string? Status)[]
    {
        ("Total Customers", ViewBag.TotalCustomers.ToString(), "Customers", null),
        ("Total Leads", ViewBag.TotalLeads.ToString(), "Leads", null),
        ("Open Leads", ViewBag.OpenLeads.ToString(), "Leads", null),
        ("Total Opportunities", ViewBag.TotalOpportunities.ToString(), "Opportunities", null),
        ("Open Opportunities", ViewBag.OpenOpportunities.ToString(), "Opportunities", "Open"),
        ("Won Opportunities", ViewBag.WonOpportunities.ToString(), "Opportunities", null),
        ("Lost Opportunities", ViewBag.LostOpportunities.ToString(), "Opportunities", null),
        ("Total Pipeline Value", ((decimal)ViewBag.PipelineValue).ToString("N2"), "Opportunities", "Open"),
    };
}
<div class="row g-3 mb-4">
    @foreach (var c in cards)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="@c.Controller" asp-action="Index" asp-route-status="@c.Status" class="card shadow-sm text-decoration-none h-100">
                <div class="card-body">
                    <div class="text-muted small">@c.Label</div>
                    <div class="fs-4 fw-semibold text-body" data-card="@c.Label">@c.Value</div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h2 class="h6">Opportunities by stage</h2>
            <canvas id="stageChart" height="220"></canvas>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h2 class="h6">Leads by status</h2>
            <canvas id="leadChart" height="220"></canvas>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center bg-white">
        <h2 class="h6 mb-0">Pending follow-ups (overdue and next 14 days)</h2>
        <a asp-controller="FollowUps" asp-action="Index" class="small">View all</a>
    </div>
    @if (pending.Count == 0)
    {
        <div class="card-body text-muted small">No pending follow-ups.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var f in pending)
            {
                var overdue = f.FollowUpDate.Date < DateTime.Today;
                <li class="list-group-item d-flex justify-content-between">
                    <span>
                        <strong>@f.FollowUpDate.ToString("dd MMM")</strong> &middot; @f.FollowUpType &middot;
                        @(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? f.Opportunity?.OpportunityName)
                        <span class="text-muted small">@f.Remarks</span>
                    </span>
                    @if (overdue) { <span class="badge bg-danger align-self-center">Overdue</span> }
                    else if (f.FollowUpDate.Date == DateTime.Today) { <span class="badge bg-warning text-dark align-self-center">Today</span> }
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === "undefined") return; // CDN unavailable: cards above still show the figures
            const opts = { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } };
            new Chart(document.getElementById("stageChart"), {
                type: "bar",
                data: { labels: @Json.Serialize(ViewBag.StageLabels), datasets: [{ data: @Json.Serialize(ViewBag.StageCounts), backgroundColor: "#0d6efd" }] },
                options: opts
            });
            new Chart(document.getElementById("leadChart"), {
                type: "bar",
                data: { labels: @Json.Serialize(ViewBag.LeadStatusLabels), datasets: [{ data: @Json.Serialize(ViewBag.LeadStatusCounts), backgroundColor: "#198754" }] },
                options: opts
            });
        })();
    </script>
}
