@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}

<h1 class="h3 mb-3">Audit Log</h1>
<p class="text-muted small">Most recent 500 entries. Times are UTC. Passwords and security tokens are never logged.</p>

@if (!Model.Any())
{
    <div class="alert alert-light border">No audit entries yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm bg-white small align-top">
            <thead class="table-light">
                <tr><th>When (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Old value</th><th>New value</th><th>IP</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr class="@(a.Action is "LoginFailed" or "LoginLockedOut" ? "table-warning" : "")">
                        <td class="text-nowrap">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@a.UserName<div class="text-muted" style="font-size:.7rem">@a.UserId</div></td>
                        <td>@a.Action</td>
                        <td>@a.EntityName</td>
                        <td>@a.RecordId<div class="text-muted">@a.Details</div></td>
                        <td><code class="text-break" style="font-size:.7rem">@a.OldValue</code></td>
                        <td><code class="text-break" style="font-size:.7rem">@a.NewValue</code></td>
                        <td class="text-nowrap">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
