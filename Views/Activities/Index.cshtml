@model IEnumerable<Activity>
@{
    ViewData["Title"] = "Activities";
    var type = ViewData["Type"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Activities</h1>
    <a asp-action="Create" class="btn btn-primary">+ Log Activity</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(type) ? "active" : "")" asp-action="Index">All</a></li>
    @foreach (var t in ActivityTypes.All)
    {
        <li class="nav-item"><a class="nav-link @(t == type ? "active" : "")" asp-action="Index" asp-route-type="@t">@t</a></li>
    }
</ul>

@if (!Model.Any()) { <div class="alert alert-light border">No activities.</div> }
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related To</th><th>Status</th><th>Assigned To</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="text-nowrap">@a.ActivityDate.ToString("dd MMM yyyy")</td>
                        <td>@a.ActivityType</td>
                        <td>@a.Subject</td>
                        <td class="small">@(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? a.Opportunity?.OpportunityName)</td>
                        <td>@a.Status</td>
                        <td>@(a.AssignedUser?.UserName ?? "—")</td>
                        <td class="text-end">
                            @if (a.Status == "Planned")
                            {
                                <form asp-action="Complete" asp-route-id="@a.Id" method="post"><button class="btn btn-sm btn-success">Complete</button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
