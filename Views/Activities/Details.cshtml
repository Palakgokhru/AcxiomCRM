@model Activity
@{
    ViewData["Title"] = Model.Subject;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.ActivityType: @Model.Subject</h1>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        @if (Model.Status == "Planned")
        {
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post"><button class="btn btn-success">Mark completed</button></form>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this activity? This cannot be undone.');">
            <button class="btn btn-outline-danger">Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
<partial name="_Alerts" />

<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Activity Id</dt><dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.ActivityDate.ToString("dddd, dd MMM yyyy")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9" style="white-space:pre-line">@(Model.Description ?? "—")</dd>
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@if (Model.Customer is not null) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a> } else { <span>—</span> }</dd>
        <dt class="col-sm-3">Lead</dt>
        <dd class="col-sm-9">@if (Model.Lead is not null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a> } else { <span>—</span> }</dd>
        <dt class="col-sm-3">Opportunity</dt>
        <dd class="col-sm-9">@if (Model.Opportunity is not null) { <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId">@Model.Opportunity.OpportunityName</a> } else { <span>—</span> }</dd>
        <dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9">@(Model.AssignedUser?.UserName ?? "Unassigned")</dd>
        <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm") by @Model.CreatedBy</dd>
    </dl>
</div></div>
